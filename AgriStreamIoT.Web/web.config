<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Used on Windows App Service (IIS). Publishing adds the ASP.NET Core handler automatically. -->
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 512 MB per request so bursts of high-resolution drone images can be uploaded. -->
        <requestLimits maxAllowedContentLength="536870912" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
