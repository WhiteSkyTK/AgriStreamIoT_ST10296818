<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- AgriStream IoT web application (ASP.NET Core MVC) - hosted on Azure App Service. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgriStreamIoT.Web</RootNamespace>
    <UserSecretsId>5d0f6a52-8f6e-4f0a-9d2b-6c4a7e1b3a91</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.27.1" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgriStreamIoT.Shared\AgriStreamIoT.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The example file is documentation only; appsettings.Local.json (git-ignored) IS published. -->
    <Content Update="appsettings.Local.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
