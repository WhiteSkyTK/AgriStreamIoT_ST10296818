{
  // Copy this file to appsettings.Local.json and fill in your own values.
  // appsettings.Local.json is git-ignored (never pushed to GitHub) but IS published to App Service.
  "ConnectionStrings": {
    // Azure portal > SQL database > Settings > Connection strings > ADO.NET (put your password in)
    "FarmSql": "Server=tcp:YOUR-SERVER.database.windows.net,1433;Initial Catalog=YOUR-DATABASE;Persist Security Info=False;User ID=YOUR-ADMIN;Password=YOUR-PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;",
    // Azure portal > Storage account > Security + networking > Access keys > Connection string
    "FarmStorage": "DefaultEndpointsProtocol=https;AccountName=YOUR-ACCOUNT;AccountKey=YOUR-KEY;EndpointSuffix=core.windows.net"
  },
  "AzureFunctions": {
    // Local: http://localhost:7071/api/   Azure: https://YOUR-FUNCTION-APP.azurewebsites.net/api/
    "BaseUrl": "http://localhost:7071/api/",
    // Function App > Functions > App keys > default (leave empty when running the functions locally)
    "Key": ""
  }
}
