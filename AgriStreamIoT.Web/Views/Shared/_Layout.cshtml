@using AgriStreamIoT.Shared.Constants
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(UserRoles.Admin);
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | AgriStream IoT</title>
    <meta name="description" content="AgriStream IoT: soil telemetry, drone imagery and irrigation control for a commercial farm, running on Azure." />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@@62..125,400..800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="visually-hidden-focusable btn btn-grain position-absolute m-2" href="#main">Skip to content</a>

    <header class="topbar">
        <nav class="navbar navbar-expand-lg" aria-label="Main">
            <div class="container-fluid" style="max-width:1320px">
                <a class="navbar-brand" asp-controller="@(signedIn ? "Dashboard" : "Home")" asp-action="Index">
                    <partial name="_BrandMark" />
                    <span>AgriStream <span class="brand-sub">IoT</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Open the menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    @if (signedIn)
                    {
                        <ul class="navbar-nav me-auto ms-lg-3 gap-lg-1">
                            <li class="nav-item"><a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2 me-1" aria-hidden="true"></i>Farm overview</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Fields")" asp-controller="Fields" asp-action="Index"><i class="bi bi-moisture me-1" aria-hidden="true"></i>Fields</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Devices")" asp-controller="Devices" asp-action="Index"><i class="bi bi-cpu me-1" aria-hidden="true"></i>Device register</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Media")" asp-controller="Media" asp-action="Index"><i class="bi bi-images me-1" aria-hidden="true"></i>Drone &amp; media</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Telemetry")" asp-controller="Telemetry" asp-action="Index"><i class="bi bi-table me-1" aria-hidden="true"></i>Telemetry</a></li>
                            @if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link @Active("Pipeline")" asp-controller="Pipeline" asp-action="Index"><i class="bi bi-diagram-3 me-1" aria-hidden="true"></i>Pipeline</a></li>
                                <li class="nav-item"><a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-1" aria-hidden="true"></i>Users</a></li>
                            }
                        </ul>
                        <div class="dropdown mt-2 mt-lg-0">
                            <a class="user-chip dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar" aria-hidden="true">@User.Initials()</span>
                                <span class="d-flex flex-column lh-sm">
                                    <span>@User.DisplayName()</span>
                                    <span class="role-tag">@User.Role()</span>
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings"><i class="bi bi-person-gear me-2" aria-hidden="true"></i>Account settings</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto gap-2 align-items-lg-center">
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="btn btn-grain btn-sm" asp-controller="Account" asp-action="Register">Create account</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main">
        @if (IsSectionDefined("Hero"))
        {
            @await RenderSectionAsync("Hero")
        }
        <div class="page">
            <partial name="_Notices" />
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="inner">
            <span>AgriStream IoT: smart farm monitoring on Azure (App Service, Functions, SQL Database, Blob, Table and Queue storage)</span>
            <span>Times shown in SAST (UTC+2)</span>
        </div>
    </footer>

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="confirmTitle">Are you sure?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"><p id="confirmMessage" class="mb-0"></p></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger-soft" id="confirmButton">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
