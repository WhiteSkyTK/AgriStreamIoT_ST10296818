@model ServiceProblemViewModel
@{
    ViewData["Title"] = Model.Service + " unavailable";
}
<div class="panel" style="max-width:760px">
    <h1 class="h3"><i class="bi bi-cloud-slash me-2" style="color:var(--watch)" aria-hidden="true"></i>@Model.Service is not responding</h1>
    <p>@Model.Hint</p>
    <div class="notice is-warn">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        <div><strong>Details</strong><p>@Model.Message</p></div>
    </div>
    <p class="small-text muted">Setting to check: <strong>@Model.Setting</strong></p>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-farm" href="javascript:location.reload()">Try again</a>
        <a class="btn btn-ghost" asp-controller="Home" asp-action="Setup">Open setup checklist</a>
    </div>
</div>
